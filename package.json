{
  "name": "howcode",
  "productName": "howcode",
  "version": "0.1.64",
  "private": true,
  "description": "Web-based coding app for Pi with projects, terminal, git, and diff workflows.",
  "license": "MIT",
  "author": "Igor Warzocha",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k \"bun run dev:web\" \"bun run dev:server\"",
    "dev:web": "vite --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "bun run build && NODE_ENV=production tsx server/index.ts",
    "prepare": "test -d .git && husky || true",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "ai:check": "bun run lint && bun run typecheck && bun run test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cts,mts,cjs,mjs,json,css,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@earendil-works/pi-tui": "0.74.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@mdxeditor/editor": "^3.55.0",
    "@pierre/diffs": "^1.1.0-beta.16",
    "@pierre/trees": "1.0.0-beta.3",
    "@tanstack/react-pacer": "^0.21.1",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "better-sqlite3": "^12.2.0",
    "esbuild": "0.27.7",
    "lucide-react": "^0.525.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.1.38",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.3.11",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.5.13",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.7",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
